---
import Layout from '../layouts/Layout.astro';
import sponsors from '../data/sponsors.json';
---
<Layout title="Sponsors — Space Impact Forum" description="Organisations partnering with the Space Impact Forum to advance sustainability and innovation in space.">
  <main class="main">

    <!-- Page Title -->
    <div class="page-title">
      <div class="heading">
        <div class="container">
          <div class="row d-flex justify-content-center text-center">
            <div class="col-lg-8">
              <h1 class="heading-title">Our Sponsors</h1>
              <p class="mb-0">
                The Space Impact Forum is proud to partner with organisations that share our commitment to sustainability, innovation, and measurable impact.
                Our sponsors play a pivotal role in supporting the Labs, research, and global collaborations that drive practical solutions across Food, Energy, Environment, and Urban systems.
              </p>
            </div>
          </div>
        </div>
      </div>
      <nav class="breadcrumbs">
        <div class="container">
          <ol>
            <li><a href="/">Home</a></li>
            <li class="current">Sponsors</li>
          </ol>
        </div>
      </nav>
    </div>
    <!-- End Page Title -->

    {sponsors.tiers.map((tier, i) => (
      <section id={`${tier.id}-sponsors`} class={`section py-5 ${i % 2 === 1 ? "bg-light" : ""}`}>
        <div class="container" data-aos="fade-up">
          <div class="row text-center mb-5">
            <div class="col-12">
              <h2 class="mb-3">{tier.label}</h2>
              {tier.description && <p class="mb-4">{tier.description}</p>}
            </div>
          </div>

          {tier.id === "lab" ? (
            <div class="row g-4 text-center">
              {tier.sponsors.map((sponsor) => (
                <div class="col-md-3 col-6">
                  <div class="card h-100 shadow-sm sponsor-card">
                    <div class="card-body">
                      <h5 class="card-title">{sponsor.lab ?? sponsor.name}</h5>
                      {sponsor.url ? (
                        <a href={sponsor.url} target="_blank" rel="noopener noreferrer">
                          <img src={sponsor.logo} alt={sponsor.name} class="img-fluid mt-3 sponsor-logo" loading="lazy" />
                        </a>
                      ) : (
                        <img src={sponsor.logo} alt={sponsor.name} class="img-fluid mt-3 sponsor-logo" loading="lazy" />
                      )}
                    </div>
                  </div>
                </div>
              ))}
            </div>
          ) : (
            <div class="row g-4 justify-content-center align-items-center">
              {tier.sponsors.map((sponsor) => (
                <div class="col-md-3 col-6 sponsor-logo-col">
                  {sponsor.url ? (
                    <a href={sponsor.url} target="_blank" rel="noopener noreferrer">
                      <img src={sponsor.logo} alt={sponsor.name} class="img-fluid sponsor-logo" loading="lazy" />
                    </a>
                  ) : (
                    <img src={sponsor.logo} alt={sponsor.name} class="img-fluid sponsor-logo" loading="lazy" />
                  )}
                </div>
              ))}
            </div>
          )}
        </div>
      </section>
    ))}

    <!-- Call to Action -->
    <section id="cta" class="section py-5 text-center">
      <div class="container" data-aos="fade-up">
        <h2 class="mb-3">Join Our Sponsorship Community</h2>
        <p class="mb-4">Become part of a global movement driving measurable impact across the Space Impact Forum's Labs and initiatives.</p>
        <a href="/contact" class="btn btn-primary btn-lg">Become a Sponsor</a>
      </div>
    </section>

  </main>
</Layout>

<style>
  .sponsor-logo-col {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 12px;
  }

  .sponsor-logo {
    max-height: 80px;
    width: auto;
    object-fit: contain;
    filter: grayscale(0.15);
    transition: filter 0.2s ease, transform 0.2s ease;
  }

  .sponsor-logo:hover {
    filter: grayscale(0);
    transform: translateY(-2px);
  }

  .sponsor-card {
    transition: transform 0.2s ease;
  }

  .sponsor-card:hover {
    transform: translateY(-4px);
  }

  @media (max-width: 576px) {
    .sponsor-logo {
      max-height: 56px;
    }
  }
</style>
